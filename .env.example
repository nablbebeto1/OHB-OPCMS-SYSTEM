# Application Runtime
PORT=3000
NODE_ENV=development
APP_DOMAIN=https://polio.orhb.gov.et

# Production Frontend & FastAPI + PostgreSQL Settings
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=1119
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4949

# Session Security
OPCMS_SESSION_SECRET=change-this-to-a-long-random-secret
SECRET_KEY=change-this-to-a-long-random-secret

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ohb_opcms
POSTGRES_USER=opcms_user
POSTGRES_PASSWORD=change_me_strong_password

# CORS & Upload Storage
CORS_ORIGINS=https://polio.orhb.gov.et,http://196.188.173.157:1119,http://192.168.100.11:1119,http://127.0.0.1:1119,http://localhost:3000
UPLOAD_DIR=/var/lib/ohb-opcms/uploads
MAX_UPLOAD_MB=25
MAX_UPLOAD_SIZE_MB=25
