# Application Runtime
PORT=3000
NODE_ENV=production
ENVIRONMENT=production
APP_DOMAIN=https://polio.orhb.gov.et

# Frontend API Base URL (leave empty for same-origin Apache reverse proxy: https://polio.orhb.gov.et/api/...)
VITE_API_BASE_URL=

# Production Frontend & FastAPI + PostgreSQL Settings
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4949

# Session & JWT Security (generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-openssl-rand-hex-32-secret
OPCMS_SESSION_SECRET=replace-with-openssl-rand-hex-32-secret

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ohb_opcms
POSTGRES_USER=opcms_user
POSTGRES_PASSWORD=change_me_strong_password

# CORS & Upload Storage
CORS_ORIGINS=https://polio.orhb.gov.et,http://127.0.0.1:3000,http://localhost:3000
UPLOAD_DIR=/var/lib/ohb-opcms/uploads
BRANDING_UPLOAD_DIR=/opt/ohb-opcms/backend/uploads/branding
MAX_UPLOAD_MB=25
MAX_UPLOAD_SIZE_MB=25
