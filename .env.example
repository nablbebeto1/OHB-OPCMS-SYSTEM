# Application Runtime
PORT=3000
NODE_ENV=production
ENVIRONMENT=production
APP_DOMAIN=https://polio.orhb.gov.et
PUBLIC_APP_URL=https://polio.orhb.gov.et

# Frontend API Base URL (leave empty for same-origin Apache reverse proxy: https://polio.orhb.gov.et/api/...)
VITE_API_BASE_URL=

# Production Frontend & FastAPI + PostgreSQL Settings
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=1119
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4949

# Session, JWT & File Preview Signing Secrets (generate with: openssl rand -hex 32)
# Cloud Run: map SECRET_KEY to Secret Manager secret "ohb-opcms-secret-key" (version: latest).
# OPCMS_SESSION_SECRET is supported as an alternative; if both are set, their values must match.
SECRET_KEY=replace-with-openssl-rand-hex-32-secret
# OPCMS_SESSION_SECRET=
# FILE_PREVIEW_SECRET=
PREVIEW_LINK_TTL_HOURS=144

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ohb_opcms
POSTGRES_USER=opcms_user
POSTGRES_PASSWORD=change_me_strong_password

# CORS & Permanent Upload Storage (must survive redeployments/rebuilds)
CORS_ORIGINS=https://polio.orhb.gov.et,http://127.0.0.1:1119,http://localhost:1119
UPLOAD_DIR=/var/lib/ohb-opcms/uploads
BRANDING_UPLOAD_DIR=/var/lib/ohb-opcms/uploads/branding
MAX_UPLOAD_MB=25
MAX_UPLOAD_SIZE_MB=25

# Initial Protected Account Provisioning (set securely in server .env; never commit real passwords)
OPCMS_INIT_ADMIN_USERNAME=Admin
OPCMS_INIT_ADMIN_PASSWORD=
OPCMS_INIT_ADMIN_EMAIL=admin@oromiahealth.gov.et
OPCMS_INIT_COMMAND_USERNAME=OHBPHEM
OPCMS_INIT_COMMAND_PASSWORD=
OPCMS_INIT_COMMAND_EMAIL=ohbphem@oromiahealth.gov.et
OPCMS_FORCE_SYNC_INIT_ACCOUNTS=false
