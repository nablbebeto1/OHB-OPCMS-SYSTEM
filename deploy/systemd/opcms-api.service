[Unit]
Description=OHB-OPCMS FastAPI Backend Service
After=network.target postgresql.service

[Service]
Type=notify
User=opcms
Group=opcms
WorkingDirectory=/opt/ohb-opcms/backend
EnvironmentFile=/opt/ohb-opcms/.env
ExecStart=/opt/ohb-opcms/backend/.venv/bin/gunicorn app.main:app \
  --workers 4 \
  --worker-class uvicorn.workers.UvicornWorker \
  --bind 127.0.0.1:4949 \
  --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
